datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  OPERATOR
}

enum Condition {
  NEW
  USED
}

enum ApplicationStatus {
  NEW
  IN_REVIEW
  APPROVED
  REJECTED
  DELIVERED
  CANCELLED
}

enum DeliveryMethod {
  DELIVERY
  PICKUP
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String
  phone        String?
  role         Role          @default(OPERATOR)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  assignedApps Application[] @relation("AssignedManager")
  statusLogs   ApplicationStatusLog[]

  @@map("users")
}

model Brand {
  id         String    @id @default(uuid())
  name       String    @unique
  slug       String    @unique
  logoUrl    String?
  isFeatured Boolean   @default(false)
  order      Int       @default(0)
  products   Product[]
  createdAt  DateTime  @default(now())

  @@map("brands")
}

model Category {
  id        String     @id @default(uuid())
  nameUz    String
  nameRu    String
  slug      String     @unique
  icon      String?
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  order     Int        @default(0)
  products  Product[]
  createdAt DateTime   @default(now())

  @@map("categories")
}

model Product {
  id                    String            @id @default(uuid())
  brandId               String
  brand                 Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  categoryId            String
  category              Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  nameUz                String
  nameRu                String
  slug                  String            @unique
  descriptionUz         String            @db.Text
  descriptionRu         String            @db.Text
  basePrice             Decimal           @db.Decimal(12, 2)
  isHit                 Boolean           @default(false)
  isNew                 Boolean           @default(false)
  isPublished           Boolean           @default(true)
  customMarkupPercent   Decimal?          @db.Decimal(5, 2)
  minDownPaymentPercent Decimal?          @db.Decimal(5, 2)
  
  variants              ProductVariant[]
  specs                 ProductSpec[]
  images                ProductImage[]
  applicationItems      ApplicationItem[]
  
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([slug])
  @@index([brandId])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id          String            @id @default(uuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String            @unique
  colorUz     String
  colorRu     String
  colorCode   String
  memoryRam   String?
  memoryRom   String?
  condition   Condition         @default(NEW)
  price       Decimal           @db.Decimal(12, 2)
  oldPrice    Decimal?          @db.Decimal(12, 2)
  stock       Int               @default(0)
  isDefault   Boolean           @default(false)
  images      ProductImage[]
  appItems    ApplicationItem[]
  createdAt   DateTime          @default(now())

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id         String          @id @default(uuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  imageUrl   String
  isPrimary  Boolean         @default(false)
  order      Int             @default(0)

  @@map("product_images")
}

model ProductSpec {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  groupUz   String
  groupRu   String
  labelUz   String
  labelRu   String
  valueUz   String
  valueRu   String
  order     Int      @default(0)

  @@index([productId])
  @@map("product_specs")
}

model InstallmentPlan {
  id                    String   @id @default(uuid())
  months                Int      @unique
  markupPercent         Decimal  @db.Decimal(5, 2)
  minDownPaymentPercent Decimal  @default(0) @db.Decimal(5, 2)
  maxDownPaymentPercent Decimal  @default(50) @db.Decimal(5, 2)
  isActive              Boolean  @default(true)
  order                 Int      @default(0)

  @@map("installment_plans")
}

model Application {
  id                   String                 @id @default(uuid())
  applicationNumber    String                 @unique
  customerName         String
  phone                String
  district             String
  address              String
  passportSeries       String?
  preferredContactTime String?
  deliveryMethod       DeliveryMethod         @default(DELIVERY)
  branchId             String?
  branch               Branch?                @relation(fields: [branchId], references: [id])
  status               ApplicationStatus      @default(NEW)
  assignedManagerId    String?
  assignedManager      User?                  @relation("AssignedManager", fields: [assignedManagerId], references: [id])
  internalNotes        String?                @db.Text
  totalPrice           Decimal                @db.Decimal(12, 2)
  downPayment          Decimal                @db.Decimal(12, 2)
  loanAmount           Decimal                @db.Decimal(12, 2)
  termMonths           Int
  monthlyPayment       Decimal                @db.Decimal(12, 2)
  markupPercent        Decimal                @db.Decimal(5, 2)
  items                ApplicationItem[]
  statusLogs           ApplicationStatusLog[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([phone])
  @@index([applicationNumber])
  @@index([status])
  @@map("applications")
}

model ApplicationItem {
  id            String         @id @default(uuid())
  applicationId String
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  productId     String
  product       Product        @relation(fields: [productId], references: [id])
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  quantity      Int            @default(1)
  unitPrice     Decimal        @db.Decimal(12, 2)

  @@map("application_items")
}

model ApplicationStatusLog {
  id            String            @id @default(uuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  oldStatus     ApplicationStatus?
  newStatus     ApplicationStatus
  changedById   String?
  changedBy     User?             @relation(fields: [changedById], references: [id])
  comment       String?
  createdAt     DateTime          @default(now())

  @@map("application_status_logs")
}

model Banner {
  id               String   @id @default(uuid())
  titleUz          String
  titleRu          String
  subtitleUz       String?
  subtitleRu       String?
  badgeUz          String?
  badgeRu          String?
  linkUrl          String
  imageUrlDesktop  String
  imageUrlMobile   String
  isActive         Boolean  @default(true)
  order            Int      @default(0)

  @@map("banners")
}

model Branch {
  id           String        @id @default(uuid())
  nameUz       String
  nameRu       String
  addressUz    String
  addressRu    String
  workingHours String
  phone        String
  latitude     Float
  longitude    Float
  isActive     Boolean       @default(true)
  applications Application[]

  @@map("branches")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?

  @@map("system_settings")
}
